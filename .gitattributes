# Normalise line endings so the repo behaves the same on every machine.
* text=auto

# Batch files MUST be CRLF. cmd.exe mis-parses `goto :label` and parenthesised
# blocks in an LF-only .bat, which fails in confusing ways: the menu never
# appears on double-click, and control falls through labels it should have
# jumped over. Force CRLF on checkout regardless of platform or core.autocrlf.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Keep shell scripts LF for the same reason in reverse.
*.sh    text eol=lf

# Binary -- never touch.
*.xlsx  binary
*.ork   binary
*.png   binary
